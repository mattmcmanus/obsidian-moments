{
	"name": "obsidian-moments",
	"version": "0.3.1",
	"description": "Unify date-based note-taking with inline moments, standalone dated notes, and a chronological timeline view.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"deploy": "npm run build && mkdir -p ~/notes/.obsidian/plugins/moments && cp dist/main.js dist/manifest.json dist/styles.css ~/notes/.obsidian/plugins/moments/",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "tsc -noEmit && eslint .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"notes",
		"timeline",
		"daily-notes"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/jest": "^29.5.12",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jest": "^29.7.0",
		"jiti": "2.6.1",
		"obsidian": "^1.12.0",
		"ts-jest": "^29.1.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {}
}
